{
	"name": "my-space",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "npm run build && wrangler dev",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"format": "prettier --write .",
		"test": "npx vitest",
		"deploy": "bun run build && wrangler deploy",
		"cf-typegen": "wrangler types ./src/worker-configuration.d.ts",
		"supabase:gen-types": "npx supabase gen types typescript --project-id 'agwsjfktovregdpcobbf' --schema public > src/lib/supabase/database.types.ts"
	},
	"devDependencies": {
		"@fontsource/open-sans": "^5.3.0",
		"@inlang/paraglide-js": "^2.25.2",
		"@inlang/plugin-m-function-matcher": "^2.2.15",
		"@inlang/plugin-message-format": "^4.4.4",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@theatre/core": "^0.7.2",
		"@threlte/core": "^8.6.0",
		"@threlte/extras": "^9.21.1",
		"@threlte/theatre": "^3.2.2",
		"@types/node": "^26.6.1",
		"@vitest/browser-playwright": "^5.0.1",
		"browserslist": "^4.29.0",
		"change-case": "^5.4.4",
		"cookie": "^0.7.2",
		"fast-xml-builder": "^1.3.1",
		"isomorphic-dompurify": "^4.2.0",
		"lightningcss": "^1.33.0",
		"marked": "^18.0.13",
		"normalize.css": "^8.0.1",
		"oxlint": "^1.83.0",
		"pixi.js": "^8.20.1",
		"posthog-js": "^1.433.5",
		"prettier": "^3.9.7",
		"prettier-plugin-svelte": "^4.1.1",
		"prism-themes": "^1.9.0",
		"prismjs": "^1.30.0",
		"sass-embedded": "^1.104.1",
		"sveaflet": "^0.1.5",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"svelte-meta-tags": "^5.0.2",
		"svelte-motion": "^0.12.2",
		"svelte-pixi": "^8.0.1",
		"svgo": "^4.1.0",
		"three": "^0.186.0",
		"typescript": "^7.0.2",
		"vite": "^8.3.0",
		"vite-plugin-image-optimizer": "^2.0.3",
		"vitest": "^5.0.1",
		"vitest-browser-svelte": "^3.1.0",
		"wrangler": "^4.132.0"
	},
	"trustedDependencies": [
		"@parcel/watcher",
		"core-js",
		"protobufjs"
	],
	"type": "module",
	"dependencies": {
		"@supabase/supabase-js": "^2.116.0",
