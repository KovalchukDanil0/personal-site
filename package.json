{
	"name": "my-space",
	"version": "0.0.1",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "npm run build && wrangler dev",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"format": "prettier --write .",
		"test": "npx vitest",
		"deploy": "bun run build && wrangler deploy",
		"cf-typegen": "wrangler types ./src/worker-configuration.d.ts",
		"supabase:gen-types": "npx supabase gen types typescript --project-id 'agwsjfktovregdpcobbf' --schema public > src/lib/supabase/database.types.ts"
	},
	"dependencies": {
		"@lucide/svelte": "^1.58.0",
		"@supabase/supabase-js": "^2.118.0",
		"generate-robotstxt": "^8.0.3",
		"isbot": "^5.2.2",
		"jspdf": "^4.2.1",
		"sanitize-html": "^2.18.1",
		"sitemap": "^9.0.1",
		"super-sitemap": "^2.0.6",
		"uuid": "^14.0.3"
	},
	"devDependencies": {
		"@fontsource/open-sans": "^5.3.0",
		"@inlang/paraglide-js": "^2.29.0",
		"@inlang/plugin-m-function-matcher": "^2.3.4",
		"@inlang/plugin-message-format": "^4.5.4",
		"@sveltejs/adapter-cloudflare": "^8.0.1",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@threlte/core": "^8.6.1",
		"@threlte/extras": "^9.22.2",
		"@types/node": "^26.6.5",
		"@types/sanitize-html": "^2.16.2",
		"@vitest/browser-playwright": "^5.0.5",
		"browserslist": "^4.29.3",
		"change-case": "^5.4.4",
		"cookie": "^2.0.1",
		"fast-xml-builder": "^1.3.1",
		"lightningcss": "^1.33.0",
		"marked": "^18.1.1",
		"normalize.css": "^8.0.1",
		"oxlint": "^1.88.0",
		"pixi.js": "^8.22.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prism-themes": "^1.9.0",
		"sass-embedded": "^1.105.2",
		"sveaflet": "^0.1.5",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"svelte-meta-tags": "^5.0.3",
		"svelte-motion": "^0.12.2",
		"svelte-pixi": "^8.0.1",
		"svgo": "^4.1.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.4",
		"vite-plugin-image-optimizer": "^2.0.3",
		"vitest": "^5.0.5",
		"vitest-browser-svelte": "^3.1.0",
		"wrangler": "^4.151.1"
	},
	"trustedDependencies": [
		"@parcel/watcher",
		"core-js",
		"protobufjs"
	],
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*",
		"#styles": "./src/styles/_index.scss",
		"#styles/*": "./src/styles/*",
		"#assets/*": "./src/assets/*",
		"#components": "./src/lib/components/index.ts"
	}
}
